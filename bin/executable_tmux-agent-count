#!/usr/bin/env bash

# Inventory of coding agents across every session on this tmux server, one
# segment per non-zero state: ●waiting ▶working ✓done. State comes from
# workmux (`workmux status --all --json`), fed by its Claude Code hooks.
#
# Icon and padding come from the catppuccin module in ~/.tmux/status/agents.conf.
# Empty output when no agents exist is load-bearing: tmux.conf tests it to
# decide whether to draw the module at all. Always exits 0 so a missing or
# failing workmux never breaks the status line.

workmux status --all --json 2> /dev/null | jq -j '
  [.agents[].status] as $s
  | [ {k: "waiting", i: "●"}, {k: "working", i: "▶"}, {k: "done", i: "✓"} ]
  | map(.k as $k | .n = ($s | map(select(. == $k)) | length))
  | map(select(.n > 0) | "\(.i)\(.n)")
  | join(" ")' 2> /dev/null

exit 0
