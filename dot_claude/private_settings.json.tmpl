{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/bin/tmux-agent-state working"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/bin/tmux-agent-state working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/bin/tmux-agent-state blocked"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/bin/tmux-agent-state done"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/bin/tmux-agent-state clear"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/hooks/statusline.py",
    "refreshInterval": 30
  },
  "model": "opus[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low"
    }
  },
  "outputStyle": "Concise",
  "skillOverrides": {
    "superpowers:using-git-worktrees": "off"
  },
  "sandbox": {
    "enabled": true,
    "filesystem": { 
      "allowRead": ["~/.ssh"],
      "allowWrite": ["~/src"] 
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(rtk read *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk tree *)",
      "Bash(rtk wc *)",
      "Bash(rtk smart *)",
      "Bash(rtk json *)",
      "Bash(rtk env)",
      "Bash(rtk diff *)",
      "Bash(rtk log *)",
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git branch *)",
      "Bash(rtk git show *)",
      "Bash(rtk git blame *)",
      "Bash(rtk git stash list)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "Bash(rtk git remote *)",
      "Bash(rtk gain *)",
      "Bash(rtk discover *)",
      "Bash(rtk session *)",
      "Bash(rtk cc-economics *)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(kubectl get *)",
      "Bash(rtk kubectl get *)",
      "Bash(kubectl config get-contexts *)",
      "Bash(rtk kubectl config get-contexts *)",
      "Bash(kubectl config current-context)",
      "Bash(rtk kubectl config current-context)",
      "Bash(kubectl logs *)",
      "Bash(rtk kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(rtk kubectl top *)",
      "Bash(kubectl kustomize *)",
      "Bash(rtk kubectl kustomize *)",
      "Bash(kubectl describe *)",
      "Bash(rtk kubectl describe *)",
      "Bash(kustomize build *)",
      "Bash(helm template *)",
      "Bash(helm show values *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(rtk aws sts get-caller-identity *)",
      "Bash(aws configure list-profiles *)",
      "Bash(rtk aws configure list-profiles *)",
      "Bash(aws ssm get-parameter *)",
      "Bash(rtk aws ssm get-parameter *)",
      "Bash(aws ssm get-parameters-by-path *)",
      "Bash(rtk aws ssm get-parameters-by-path *)",
      "Bash(aws ssm get-parameter-history *)",
      "Bash(rtk aws ssm get-parameter-history *)",
      "Bash(aws ssm describe-parameters *)",
      "Bash(rtk aws ssm describe-parameters *)",
      "Bash(aws ssm get-command-invocation *)",
      "Bash(rtk aws ssm get-command-invocation *)",
      "Bash(aws cloudformation describe-* *)",
      "Bash(rtk aws cloudformation describe-* *)",
      "Bash(aws ec2 describe-* *)",
      "Bash(rtk aws ec2 describe-* *)",
      "Bash(aws elbv2 describe-* *)",
      "Bash(rtk aws elbv2 describe-* *)",
      "Bash(aws ecr list-images *)",
      "Bash(rtk aws ecr list-images *)",
      "Bash(aws ecr describe-images *)",
      "Bash(rtk aws ecr describe-images *)",
      "Bash(aws eks list-clusters *)",
      "Bash(rtk aws eks list-clusters *)",
      "Bash(aws acm list-certificates *)",
      "Bash(rtk aws acm list-certificates *)",
      "Bash(aws logs describe-log-groups *)",
      "Bash(rtk aws logs describe-log-groups *)",
      "Bash(aws logs get-query-results *)",
      "Bash(rtk aws logs get-query-results *)",
      "Bash(aws pricing get-products *)",
      "Bash(rtk aws pricing get-products *)",
      "Bash(argocd app get *)",
      "Bash(argocd app diff *)",
      "Bash(bb pr comments *)",
      "Bash(bb pipeline status *)",
      "Bash(bb pipeline trace *)",
      "Bash(bb pipeline artifacts *)",
      "Bash(terraform fmt *)",
      "Bash(terraform providers *)",
      "Bash(cfn-lint *)",
      "Bash(shellcheck *)",
      "Bash(yq *)",
      "mcp__claude_ai_Atlassian__getJiraIssue"

    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git -C * push*)",
      "Bash(git * push *)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "claude-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/oligot/claude-skills.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "user-skills@claude-skills": true,
    "ponytail@ponytail": true
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
